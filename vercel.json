{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": ".generated/api/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/garuda",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/garuda/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/market",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/stakes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/lend",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/get-wise",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/problem",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/solution",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/crops",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/wisetoken/tvl",
      "destination": "https://wise.one/api/wisetoken/tvl"
    },
    {
      "source": "/api/wise-price",
      "destination": "https://wise.one/api/wise-price"
    },
    {
      "source": "/api/subgraph",
      "destination": "https://wise.one/api/subgraph"
    },
    {
      "source": "/api/opensea/nfts/:address",
      "destination": "https://wise.one/api/opensea/nfts/:address"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/garuda/:path*",
      "destination": "/garuda/index.html"
    },
    {
      "source": "/market",
      "destination": "/garuda/index.html"
    },
    {
      "source": "/stakes",
      "destination": "/garuda/index.html"
    },
    {
      "source": "/lend",
      "destination": "/garuda/index.html"
    },
    {
      "source": "/get-wise",
      "destination": "/garuda/index.html"
    },
    {
      "source": "/problem",
      "destination": "/garuda/index.html"
    },
    {
      "source": "/solution",
      "destination": "/garuda/index.html"
    },
    {
      "source": "/crops",
      "destination": "/garuda/index.html"
    }
  ],
  "regions": [
    "iad1"
  ],
  "trailingSlash": false
}
