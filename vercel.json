{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": ".generated/api/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/garuda",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/garuda/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/wise-price",
      "destination": "https://wise.one/api/wise-price"
    },
    {
      "source": "/api/subgraph",
      "destination": "https://wise.one/api/subgraph"
    },
    {
      "source": "/api/opensea/nfts/:address",
      "destination": "https://wise.one/api/opensea/nfts/:address"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/garuda/:path*",
      "destination": "/garuda/index.html"
    }
  ]
}
