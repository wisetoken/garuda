---
/** The theme's line icons (Figma "Icon"): up-right arrow, right arrow, plus, cross. Always decorative. */
interface Props {
  name?: 'ne' | 'right' | 'plus' | 'close';
  class?: string;
  /** Stroke width in viewBox units. */
  stroke?: number;
}
const { name = 'ne', class: cls = 'arr', stroke = 1.3 } = Astro.props;
const PATHS = {
  ne: { box: 14, d: 'M2 12 L12 2 M4.5 2 H12 V9.5' },
  right: { box: 20, d: 'M2 10 H18 M12 4 L18 10 L12 16' },
  plus: { box: 16, d: 'M8 1 V15 M1 8 H15' },
  close: { box: 22, d: 'M3 3 L19 19 M19 3 L3 19' },
};
const p = PATHS[name];
---

<svg class={cls} viewBox={`0 0 ${p.box} ${p.box}`} fill="none" stroke="currentColor" stroke-width={stroke} aria-hidden="true" focusable="false"><path d={p.d}></path></svg>
