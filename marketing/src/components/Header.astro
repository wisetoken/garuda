---
/**
 * Fixed header (Figma "Top bar" and the home header). Desktop: the mark, then the studio name and
 * breadcrumbs on inner pages or the four-line descriptor on the home page, the city, the burger.
 * Phones: the mark, "menu" and the burger, with a rule under them. Transparent at the top; after 8 px
 * of scroll (scripts/site.ts adds .is-scrolled) it turns into one compact blurred row and the
 * descriptor folds away.
 */
import Mark from './Mark.astro';
import type { Content, Link } from '../lib/types';

interface Props {
  c: Content;
  home?: boolean;
  /** Breadcrumbs after "Home"; the last one is the current page. */
  crumbs?: Link[];
}
const { c, home = false, crumbs = [] } = Astro.props;
const lines = c.site.descriptor.split(/\n+/);
---

<header class:list={['hd', home && 'hd--home']} data-header>
  <div class="hd__bar">
    <a class="hd__logo" href="/" aria-label={`${c.site.name}, ${c.ui.home.toLowerCase()}`}>
      <Mark />
      <span class="hd__name" aria-hidden="true">{c.site.name}</span>
    </a>
    {
      home ? (
        <div class="hd__fold">
          <p class="hd__desc">{lines.map((l, i) => (i ? [<br />, l] : l))}</p>
        </div>
      ) : (
        crumbs.length > 0 && (
          <nav class="hd__crumbs" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="/">
                  <span class="ul">{c.ui.home}</span>
                </a>
              </li>
              {crumbs.map((cr, i) => (
                <li>
                  <span class="hd__sep" aria-hidden="true">
                    /
                  </span>
                  {i === crumbs.length - 1 ? (
                    <span aria-current="page">{cr.label}</span>
                  ) : (
                    <a href={cr.href}>
                      <span class="ul">{cr.label}</span>
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      )
    }
    <nav class="hd__actions" aria-label="Open WiseOne apps">
      <a class="hd__primary" href="/market">Open Garuda Extension <span aria-hidden="true">↗</span></a>
      <a class="hd__secondary" href="https://wise.one/">Open Main Website <span aria-hidden="true">↗</span></a>
    </nav>
    <button class="hd__menu" type="button" aria-label={c.ui.openMenu} aria-expanded="false" aria-controls="menu" data-menu-open>
      <span class="hd__label" aria-hidden="true">{c.ui.menu}</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .hd {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    font-size: var(--fs-label);
    line-height: 16px;
    transition:
      background-color var(--t-ui) var(--ease),
      box-shadow var(--t-ui) var(--ease);
  }
  /* Phones: 62 px with the rule under it. */
  .hd__bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 63px;
    padding: 0 16px;
    box-shadow: inset 0 -1px 0 var(--rule);
  }
  :global(.hd.is-scrolled) {
    background: rgba(236, 236, 234, 0.85);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .hd__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-right: auto;
  }
  .hd__name {
    display: inline;
  }
  .hd__fold,
  .hd__crumbs,
  .hd__city {
    display: none;
  }
  .hd__menu {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-right: -6px;
    padding: 0 6px;
  }
  .burger {
    position: relative;
    display: block;
    width: 30px;
    height: 12px;
  }
  .burger span {
    position: absolute;
    right: 0;
    width: 100%;
    height: 1.6px;
    background: var(--orange);
    transform-origin: right;
    transition: transform var(--t-hover) var(--ease);
  }
  .burger span:first-child {
    top: 0.2px;
  }
  .burger span:last-child {
    bottom: 0.2px;
  }
  /* Hover: the lines move apart and the top one shortens from the left. */
  .hd__menu:hover .burger span:first-child,
  .hd__menu:focus-visible .burger span:first-child {
    transform: translateY(-2px) scaleX(0.6);
  }
  .hd__menu:hover .burger span:last-child,
  .hd__menu:focus-visible .burger span:last-child {
    transform: translateY(2px);
  }

  @media (min-width: 1024px) {
    .hd {
      font-size: var(--fs-label);
    }
    .hd__bar {
      align-items: flex-start;
      height: auto;
      min-height: 78px;
      padding: 24px 24px 0;
      transition:
        min-height var(--t-hover) var(--ease),
        padding var(--t-hover) var(--ease);
    }
    :global(.hd.is-scrolled) .hd__bar {
      min-height: 64px;
      padding-top: 17px;
    }
    .hd--home .hd__bar {
      box-shadow: none;
    }
    :global(.hd--home.is-scrolled) .hd__bar {
      box-shadow: inset 0 -1px 0 var(--rule);
    }
    .hd__logo {
      min-height: 30px;
      margin: 0;
    }
    .hd__name {
      display: block;
      font-size: 1.125rem;
      line-height: 22px;
      margin-top: 1px;
    }
    .hd__label {
      display: none;
    }
    /* Positions follow the 1440 frame: descriptor and breadcrumbs at x 256, the city at x 1166. */
    .hd__fold,
    .hd__crumbs {
      display: block;
      position: absolute;
      left: 17.78%;
      top: 24px;
      transition: top var(--t-hover) var(--ease);
    }
    .hd__crumbs {
      top: 31px;
    }
    :global(.hd.is-scrolled) .hd__crumbs {
      top: 24px;
    }
    .hd__fold {
      display: grid;
      grid-template-rows: 1fr;
      transition:
        grid-template-rows var(--t-hover) var(--ease),
        opacity var(--t-ui) var(--ease),
        top var(--t-hover) var(--ease);
    }
    :global(.hd.is-scrolled) .hd__fold {
      grid-template-rows: 0fr;
      opacity: 0;
    }
    .hd__desc {
      min-height: 0;
      overflow: hidden;
      line-height: 16px;
    }
    .hd__crumbs ol {
      display: flex;
      gap: 0.35em;
    }
    .hd__crumbs li {
      display: flex;
      gap: 0.35em;
    }
    .hd__crumbs a {
      color: var(--grey-text);
      transition: color var(--t-ui) var(--ease);
    }
    .hd__crumbs a:hover,
    .hd__crumbs a:focus-visible {
      color: var(--ink);
    }
    .hd__sep {
      color: var(--grey-text);
    }
    .hd__city {
      display: block;
      position: absolute;
      left: 80.97%;
      top: 31px;
      transition: top var(--t-hover) var(--ease);
    }
    .hd--home .hd__city {
      top: 24px;
    }
    :global(.hd.is-scrolled) .hd__city {
      top: 24px;
    }
    .hd__menu {
      position: absolute;
      right: 18px;
      top: 14px;
      transition: top var(--t-hover) var(--ease);
    }
    :global(.hd.is-scrolled) .hd__menu {
      top: 10px;
    }
  }
</style>

<style> .hd--home .hd__fold { display: none; } .hd__name { font-weight: 400; } </style>

<style>
  .hd__logo :global(.mark) { width: 60px; height: 60px; }
  .hd__logo { gap: 14px; }
  .hd__name { font-size: calc(var(--fs-label) * 3); line-height: 1; margin-top: 0; }
  .hd__bar { height: 96px; }
  @media (min-width: 1024px) {
    .hd__name { font-size: 3.375rem; }
    .hd__bar, :global(.hd.is-scrolled) .hd__bar {
      height: 108px; min-height: 108px; padding: 24px; align-items: center;
    }
    .hd__city, .hd--home .hd__city, :global(.hd.is-scrolled) .hd__city { top: 46px; }
    .hd__menu, :global(.hd.is-scrolled) .hd__menu { top: 32px; }
  }
  @media (max-width: 380px) { .hd__label { display: none; } }
</style>

<style>@media(min-width:1024px){.hd__city{left:auto;right:100px}}</style>

<style>
  .hd__actions { display:flex; align-items:center; gap:24px; margin-left:auto; margin-right:70px; font-size:18px; line-height:1.3; white-space:nowrap; }
  .hd__actions a { display:inline-flex; align-items:center; gap:14px; min-height:48px; transition:background-color .2s ease, color .2s ease; }
  .hd__primary { padding:14px 22px; border-radius:999px; background:var(--orange-deep); color:var(--white); }
  .hd__primary:hover { background:#006b67; color:var(--white); }
  .hd__secondary:hover { color:var(--orange-ink); }
  .hd__actions a:focus-visible { outline:2px solid var(--orange); outline-offset:4px; }
  @media (max-width:1199px) and (min-width:1024px) { .hd__actions { font-size:16px; gap:16px; margin-right:52px; } .hd__primary { padding:13px 18px; } }
  @media (max-width:1023px) {
    :global(:root) { --header:164px; }
    .hd__bar { height:164px; padding-bottom:68px; }
    .hd__actions { position:absolute; bottom:12px; left:16px; right:16px; margin:0; gap:20px; justify-content:flex-end; font-size:16px; }
  }
  @media (max-width:540px) {
    .hd__actions { gap:12px; justify-content:space-between; font-size:12px; }
    .hd__actions a { gap:7px; min-height:44px; }
    .hd__primary { padding:12px 14px; }
  }
</style>
