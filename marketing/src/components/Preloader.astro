---
/**
 * Home preloader (first visit per session, never for reduced motion; Base.astro decides in an inline
 * script and scripts/site.ts plays it). A canvas screen with the mark in the middle and a thin counter
 * 00 to 100 under it. The pill spins one full turn while the counter runs, then the pill itself becomes
 * the window: a hole of the same shape grows from the centre until it covers the screen and shows the
 * page through it. A click or a key skips it; it never takes more than 2.2 s.
 */
---

<div class="pre" aria-hidden="true" data-preloader>
  <svg class="pre__svg" width="100%" height="100%">
    <defs>
      <mask id="pre-hole" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
        <rect width="100%" height="100%" fill="#fff"></rect>
        <svg x="50%" y="50%" overflow="visible">
          <rect class="pre__hole" x="-7.2" y="-22.8" width="14.4" height="45.6" rx="7.2" fill="#000"></rect>
        </svg>
      </mask>
    </defs>
    <g mask="url(#pre-hole)">
      <rect width="100%" height="100%" fill="#ECECEA"></rect>
      <svg x="50%" y="50%" overflow="visible">
        <g class="pre__logo">
          <circle r="36" fill="#00a9a5"></circle>
          <rect class="pre__pill" x="-7.2" y="-22.8" width="14.4" height="45.6" rx="7.2" fill="#fff"></rect>
        </g>
        <text class="pre__n" y="74" text-anchor="middle" data-pre-count>00</text>
      </svg>
    </g>
  </svg>
</div>

<style>
  .pre {
    display: none;
  }
  :global(html.pre) .pre {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 400;
    cursor: progress;
  }
  .pre__svg {
    width: 100%;
    height: 100%;
  }
  .pre__hole,
  .pre__pill {
    transform-box: view-box;
    transform-origin: 0 0;
    transform: rotate(35deg);
  }
  .pre__hole {
    transform: rotate(35deg) scale(0);
  }
  .pre__n {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 200;
    letter-spacing: 0.08em;
    fill: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
