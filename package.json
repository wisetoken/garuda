{
  "name": "garuda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test scripts/test-*.mjs",
    "test:market:fork": "node --import tsx scripts/verify-market-fork.mjs",
    "server": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "arkiv:query": "node --env-file-if-exists=.env.local --import tsx scripts/arkiv-query.mjs",
    "test:market:api": "node --import tsx scripts/verify-market-api.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hono/node-server": "1.19.11",
    "@tanstack/react-query": "5.81.5",
    "hono": "4.11.9",
    "lucide-react": "1.6.0",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.1",
    "thirdweb": "5.120.1",
    "viem": "2.53.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tsx": "4.21.0",
    "typescript": "5.7.2",
    "vite": "8.2.0"
  },
  "license": "MIT"
}
