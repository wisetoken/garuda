# Public browser identifier, configured for your app's origin in Thirdweb.
VITE_THIRDWEB_CLIENT_ID=
# Optional public Ethereum read endpoint. Never put a private API key here.
VITE_MAINNET_RPC_URL=
# Development / preview proxies. Configure equivalent routes in production.
GARUDA_API_ORIGIN=http://127.0.0.1:3202
GARUDA_MARKET_API_ORIGIN=http://127.0.0.1:3213

# Server-only market configuration. Never prefix these variables with VITE_.
GARUDA_API_HOST=127.0.0.1
GARUDA_API_PORT=3213
GARUDA_DEPLOYMENT_FILE=scripts/fixtures/signature-market.json
GARUDA_DATABASE_URL=postgresql://localhost:5432/garuda
GARUDA_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional Advanced collection manifest, only after its validator is configured.
GARUDA_ADVANCED_DEPLOYMENT_FILE=

# Dedicated Arkiv Rabdi testnet publisher, funded with test tokens only.
# Leave the private key empty for read-only discovery.
ARKIV_PUBLISHER_PRIVATE_KEY=
ARKIV_PUBLISHER_ADDRESS=0x8d5b491D2c843F6B996De1EC66269809138cA60A
# Recommended free server-side access key from https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
